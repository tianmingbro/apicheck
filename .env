# ==================== 服务端基础配置 ====================
# 服务监听地址和端口
HOST=0.0.0.0
PORT=8000
# 是否启用调试模式（生产环境设为 false）
DEBUG=true

# CLI 默认连接的服务端地址
KEYPILOT_SERVER_URL=http://localhost:8000
# 或者兼容旧名称
API_FARM_SERVER_URL=http://localhost:8000

# ==================== 数据库配置 ====================
# PostgreSQL 连接 URL（本地 Docker）
DATABASE_URL=postgresql+asyncpg://keypilot:keypilot123@localhost:5432/keypilot
# 如果服务端也运行在 Docker 中，则使用容器名：
# DATABASE_URL=postgresql://keypilot:keypilot123@keypilot-postgres:5432/keypilot

# ==================== Redis 配置 ====================
# Redis 连接 URL（本地 Docker）
REDIS_URL=redis://localhost:6379/0
# 如果服务端也运行在 Docker 中：
# REDIS_URL=redis://keypilot-redis:6379/0

# ==================== JWT 认证 ====================
# JWT 密钥（必须是一个足够长的随机字符串，建议 32 位以上）
# 生成方式见下文
JWT_SECRET_KEY=InGugglWweCRd7RzuV+fq3uhjZlySPom5o+yJLYR1pw=
# JWT 算法（推荐 HS256）
JWT_ALGORITHM=HS256
# Access Token 过期时间（分钟），默认 7 天 = 10080 分钟
JWT_EXPIRE_MINUTES=10080

# ==================== 负载均衡策略 ====================
# 可选值: round_robin, least_used, random
LOAD_BALANCER_STRATEGY=round_robin

# ==================== 上游 API 默认设置 ====================
# 默认的超时时间（秒）
DEFAULT_TIMEOUT=30
# 默认的最大重试次数
MAX_RETRIES=2

# ==================== 配额与计费 ====================
# 默认免费套餐每月额度（次数）
FREE_TIER_QUOTA=1000

# ==================== 日志级别 ====================
# 可选: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== 管理员账号（首次初始化用） ====================
# 在 init_db 脚本中会创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@example.com

ENCRYPTION_KEY=Uokdpu_spsMOw2PKcYLMGdvuYZKucKxyH6Q2hV-Hte0=   # 使用 Fernet.generate_key() 生成